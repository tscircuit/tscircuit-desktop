@@ -71,7 +71,8 @@ const TelemetryEnvConfig = Config.all({
   posthogHost: Config.String("TSCIRCUIT_DESKTOP_POSTHOG_HOST").pipe(
     Config.withDefault("https://ingest.t3.codes"),
   ),
-  enabled: Config.Boolean("TSCIRCUIT_DESKTOP_TELEMETRY_ENABLED").pipe(Config.withDefault(true)),
