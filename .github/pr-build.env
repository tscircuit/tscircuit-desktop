# Build settings for pull request builds only. Releases from main ignore this file.
#
# The Circuit tab's own header needs tscircuit/runframe#6289. Until that is
# merged and deployed to runframe.tscircuit.com, pull request builds load
# RunFrame from that pull request's preview. Delete the line below afterwards.
VITE_TSCIRCUIT_RUNFRAME_URL=https://runframe-git-host-controlled-header-tscircuit.vercel.app/iframe.html
