FROM node:24-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json upstream.json renames.json skill.json viewer.json ./
COPY overlay ./overlay
COPY patches ./patches
COPY scripts/setup.ts scripts/review-preview.ts scripts/inline-review-viewer.ts ./scripts/
COPY scripts/lib ./scripts/lib
COPY scripts/fixtures/review-preview ./scripts/fixtures/review-preview
RUN node scripts/setup.ts --no-install \
    && node_version=$(node -p "require('./.t3code/package.json').engines.node") \
    && pnpm_package=$(node -p "require('./.t3code/package.json').packageManager") \
    && npm install --prefix .cache/preview-tools --no-package-lock \
      "node@$node_version" "${pnpm_package%%+*}" httpxy@0.5.6 @vercel/sandbox@4.0.0 \
      @openai/codex@0.169.0 bun@1.4.4 tscircuit@0.0.3191 @tscircuit/circuit-json-util@0.0.131 \
    && export PATH="/app/.cache/preview-tools/node_modules/.bin:$PATH" \
    && pnpm --dir .t3code install --frozen-lockfile --filter 't3...' --filter '@t3tools/web...' \
    && pnpm --dir .t3code --filter '@t3tools/web' run build \
    && node scripts/inline-review-viewer.ts \
    && TMPDIR=/tmp node scripts/review-preview.ts --seed-hosted \
    && rm -rf .t3code/.git .t3code/.repos

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git libatomic1 ngspice util-linux \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json /app/package.json
COPY --chown=node:node scripts /app/scripts
COPY --from=build --chown=node:node /app/.t3code /app/.t3code
COPY --from=build --chown=node:node /app/.cache/preview-state.sqlite /app/.cache/preview-state.sqlite
COPY --from=build --chown=node:node /app/.cache/preview-tools/node_modules /app/.cache/preview-tools/node_modules
ENV PATH="/app/.cache/preview-tools/node_modules/.bin:$PATH"
ENV TMPDIR=/tmp
USER node
RUN codex --version && tsci --help > /dev/null && ngspice --version > /dev/null
CMD ["node", "scripts/serve-review-preview.ts"]
